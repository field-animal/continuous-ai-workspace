#!/usr/bin/env bash
# =============================================================================
# CAW 공용 래퍼 - Claude Code CLI (bin/claude)
# 목적:
#   1) 확장 프로그램 내부 비공개 경로(/config/extensions/...)에 의존하지 않고,
#      호스트에 공식 설치(claude install)된 스탠드얼론 바이너리를 안전하게 위임 호출
#   2) 컨테이너 내장 터미널과 외부 호스트 셸 간 동일한 claude CLI 실행 환경 보장 및 EBUSY 방지
# =============================================================================
set -euo pipefail

SELF_REAL="$(realpath "${BASH_SOURCE[0]}")"
HOST_HOME_DIR="${CAW_HOST_HOME:-${HOME}}"

resolve_real_claude() {
    local candidate candidate_real
    local candidates=(
        "${HOST_HOME_DIR}/.local/bin/claude"
        "/opt/caw/host-bin/claude"
    )

    for candidate in "${candidates[@]}"; do
        if [[ -x "${candidate}" ]]; then
            candidate_real="$(realpath "${candidate}" 2>/dev/null || true)"
            if [[ -n "${candidate_real}" && "${candidate_real}" != "${SELF_REAL}" ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
    done

    local IFS=':'
    local dir
    for dir in ${PATH}; do
        [[ -z "${dir}" ]] && continue
        candidate="${dir}/claude"
        if [[ -x "${candidate}" ]]; then
            candidate_real="$(realpath "${candidate}" 2>/dev/null || true)"
            if [[ -n "${candidate_real}" && "${candidate_real}" != "${SELF_REAL}" ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
    done

    return 1
}

REAL_CLAUDE="$(resolve_real_claude || true)"
if [[ -z "${REAL_CLAUDE}" ]]; then
    echo "[CAW][ERROR] 호스트 공식 스탠드얼론 claude CLI 바이너리를 찾을 수 없습니다 (${HOST_HOME_DIR}/.local/bin/claude)." >&2
    echo "[CAW][INFO] 호스트 셸에서 공식 설치 스크립트로 claude CLI를 먼저 설치하세요." >&2
    exit 1
fi

exec "${REAL_CLAUDE}" "$@"
