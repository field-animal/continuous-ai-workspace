#!/usr/bin/env bash
# =============================================================================
# CAW (Continuous AI Workspace) 통합 세션 관리 CLI (bin/caw)
# 목적:
#   - attach : 호스트 멀티플렉서(zellij 또는 tmux) 세션 연결 단축 명령 (원본 명령 직접 사용도 가능)
#   - status : 실행 중인 AI 에이전트/멀티플렉서 자원 현황 및 대화 락(.lock) 조회
#   - unlock : 브라우저 종료 후 유휴 code-server 허브(agy --hub)가 잡고 있는 대화 락 해제
#   - clean  : 종료된(EXITED) 멀티플렉서 잔여 세션 캐시 정리
#   - doctor : 인증 링크, 보안 경계 모드, systemd Linger 설정 등 환경 무결성 검증
# =============================================================================
set -euo pipefail

SELF_REAL="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF_REAL}")" && pwd)"
STACK_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# 호스트 셸에서 직접 실행될 때 패키지 .env 설정(세션명·소켓 모드 등)을 미설정 변수에 한해 안전 적재
if [[ ! -f "/.dockerenv" && -f "${STACK_ROOT}/lib/common.sh" && -f "${STACK_ROOT}/.env" ]]; then
    # shellcheck source=../lib/common.sh
    source "${STACK_ROOT}/lib/common.sh"
    caw_load_env_file "${STACK_ROOT}/.env" 1 || true
fi

HOST_HOME_DIR="${CAW_HOST_HOME:-${HOST_HOME:-${HOME}}}"
DEFAULT_SESSION="${CAW_SESSION_NAME:-caw}"
SHARE_SOCKET="${CAW_SHARE_MUX_SOCKET:-false}"
MUX_ROOT="${CAW_MUX_SOCKET_DIR:-${HOST_HOME_DIR}/.cache/caw/mux}"

CAW_VERSION="0.1.16-261124"
if [[ -f "${STACK_ROOT}/VERSION" ]]; then
    CAW_VERSION="$(tr -d '[:space:]' < "${STACK_ROOT}/VERSION")"
fi

log_info() { printf '[CAW][INFO] %s\n' "$*"; }
log_warn() { printf '[CAW][WARN] %s\n' "$*" >&2; }
log_err()  { printf '[CAW][ERROR] %s\n' "$*" >&2; }

validate_session_name() {
    local name="${1:-}"
    if [[ ! "${name}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        log_err "유효하지 않은 세션 이름입니다 (영문, 숫자, ., _, - 만 허용): ${name}"
        return 1
    fi
}

# 확정된 단일 멀티플렉서 모드(zellij | tmux | none)를 판별하는 함수
resolve_active_mux() {
    local mux="${CAW_MULTIPLEXER:-}"
    local state_file
    for state_file in "/opt/caw/host-bin/active-mux" "${STACK_ROOT}/.caw-state/host-bin/active-mux"; do
        if [[ -z "${mux}" || "${mux}" == "auto" ]]; then
            if [[ -f "${state_file}" ]]; then
                mux="$(tr -d '[:space:]' < "${state_file}")"
                break
            fi
        fi
    done

    mux="${mux:-auto}"
    if [[ "${mux}" == "auto" ]]; then
        if command -v tmux >/dev/null 2>&1; then
            mux="tmux"
        elif command -v zellij >/dev/null 2>&1; then
            mux="zellij"
        else
            mux="none"
        fi
    fi

    printf '%s\n' "${mux}"
}

# 1. 멀티플렉서 세션 연결 (기본: SSH 2중 인증 경계 모드에서는 호스트 셸에서만 순정 소켓 연결)
cmd_attach() {
    local session_name="${1:-${DEFAULT_SESSION}}"
    validate_session_name "${session_name}"

    if [[ -f "/.dockerenv" && "${SHARE_SOCKET}" != "true" ]]; then
        log_err "현재 호스트 SSH 2중 인증 경계 모드(CAW_SHARE_MUX_SOCKET=false)가 적용되어 있습니다."
        log_info "컨테이너에서 호스트로의 무인증 소켓 직결은 차단되어 있으므로, 먼저 'ssh <계정>@<호스트_IP>'로 로그인한 뒤 멀티플렉서를 실행하세요."
        return 1
    fi

    local active_mux
    active_mux="$(resolve_active_mux)"

    case "${active_mux}" in
        zellij)
            if [[ "${SHARE_SOCKET}" == "true" ]]; then
                export ZELLIJ_SOCKET_DIR="${ZELLIJ_SOCKET_DIR:-${MUX_ROOT}/zellij}"
                mkdir -p "${ZELLIJ_SOCKET_DIR}"
                chmod 700 "${MUX_ROOT}" "${ZELLIJ_SOCKET_DIR}" 2>/dev/null || true
            fi
            log_info "Zellij 세션 연결: ${session_name}"
            exec zellij attach -c "${session_name}"
            ;;
        tmux)
            if [[ "${SHARE_SOCKET}" == "true" ]]; then
                export TMUX_TMPDIR="${TMUX_TMPDIR:-${MUX_ROOT}/tmux}"
                mkdir -p "${TMUX_TMPDIR}"
                chmod 700 "${MUX_ROOT}" "${TMUX_TMPDIR}" 2>/dev/null || true
            fi
            log_info "tmux 세션 연결: ${session_name}"
            exec tmux new-session -A -s "${session_name}"
            ;;
        none|*)
            log_err "활성화된 터미널 멀티플렉서가 없습니다 (현재 모드: ${active_mux})."
            log_info "호스트에 tmux 또는 zellij를 설치한 뒤 실행하세요."
            return 1
            ;;
    esac
}

# 2. 활성 에이전트 프로세스, 멀티플렉서 세션, SQLite 대화 잠금(.lock) 상태 조회
cmd_status() {
    local active_mux
    active_mux="$(resolve_active_mux)"

    printf '=== [1] AI 에이전트 및 멀티플렉서 프로세스 현황 ===\n'
    # 다중 사용자 호스트에서 현재 실행 계정(UID) 소유 프로세스만 조회
    ps -u "$(id -u)" -o pid,etimes,rss,args --no-headers 2>/dev/null | awk '
        /([/ ]agy([ ]|$)|[/ ]claude([ ]|$)|[/ ]zellij([ ]|$)|[/ ]tmux([ ]|$))/ && !/awk/ && !/caw status/ {
            mb = $3 / 1024.0
            mins = int($2 / 60)
            cmd = ""
            for (i = 4; i <= NF; i++) cmd = cmd (i == 4 ? "" : " ") $i
            printf "  PID=%-7s 경과=%-5dm 메모리=%6.1fMB  명령=%s\n", $1, mins, mb, substr(cmd, 1, 90)
            found = 1
        }
        END {
            if (!found) print "  (현재 셸 네임스페이스 내 실행 중인 agy / claude / zellij / tmux 프로세스 없음)"
        }
    '

    printf '\n=== [2] 멀티플렉서 세션 목록 (모드: %s, 소켓직결: %s) ===\n' "${active_mux}" "${SHARE_SOCKET}"
    if [[ -f "/.dockerenv" && "${SHARE_SOCKET}" != "true" ]]; then
        printf '  (호스트 SSH 2중 인증 경계 적용 중 - 호스트 SSH 로그인 후 조회 가능)\n'
    else
        case "${active_mux}" in
            zellij)
                [[ "${SHARE_SOCKET}" == "true" ]] && export ZELLIJ_SOCKET_DIR="${ZELLIJ_SOCKET_DIR:-${MUX_ROOT}/zellij}"
                if command -v zellij >/dev/null 2>&1; then
                    zellij list-sessions 2>/dev/null || printf '  (활성 Zellij 세션 없음)\n'
                else
                    printf '  (zellij 미감지)\n'
                fi
                ;;
            tmux)
                [[ "${SHARE_SOCKET}" == "true" ]] && export TMUX_TMPDIR="${TMUX_TMPDIR:-${MUX_ROOT}/tmux}"
                if command -v tmux >/dev/null 2>&1; then
                    tmux list-sessions 2>/dev/null || printf '  (활성 tmux 세션 없음)\n'
                else
                    printf '  (tmux 미감지)\n'
                fi
                ;;
            *)
                printf '  (멀티플렉서 비활성/none 모드)\n'
                ;;
        esac
    fi

    printf '\n=== [3] Antigravity 통합 저장소 대화 잠금(.lock) 점유 현황 ===\n'
    local presence_dir="${HOST_HOME_DIR}/.gemini/antigravity/presence"
    if [[ -d "${presence_dir}" ]] && command -v lsof >/dev/null 2>&1; then
        local locks
        locks="$(lsof +D "${presence_dir}" 2>/dev/null || true)"
        if [[ -n "${locks}" ]]; then
            printf '%s\n' "${locks}"
            printf '  * 안내: 브라우저를 닫은 뒤 CLI에서 위 대화를 이어가려면 `caw unlock` 실행\n'
        else
            printf '  (점유 중인 대화 .lock 없음 - IDE 및 CLI 즉시 전환 가능)\n'
        fi
    else
        printf '  (잠금 디렉토리 미생성 또는 lsof 미설치)\n'
    fi
}

# 3. 유휴 code-server 허브(agy --hub)의 대화 락 안전 해제 (CLI TUI 세션은 보존)
cmd_unlock() {
    local dry_run=0
    if [[ "${1:-}" == "--dry-run" ]]; then
        dry_run=1
    fi

    local hub_pids=()
    # 타 사용자 프로세스 간섭 방지를 위해 현재 계정(UID) 소유의 agy --hub 만 필터링
    while IFS= read -r pid; do
        [[ -n "${pid}" ]] && hub_pids+=("${pid}")
    done < <(ps -u "$(id -u)" -o pid,args --no-headers 2>/dev/null | awk '/[/ ]agy([ ]|$)/ && /--hub/ && !/awk/ {print $1}')

    if [[ "${#hub_pids[@]}" -eq 0 ]]; then
        log_info "현재 실행 중인 IDE 허브(agy --hub) 프로세스가 없습니다. 해제할 잠금이 없습니다."
        return 0
    fi

    if [[ "${dry_run}" -eq 1 ]]; then
        log_info "[DRY-RUN] 종료 대상 IDE 허브(agy --hub) PID: ${hub_pids[*]}"
        return 0
    fi

    log_info "IDE 허브(agy --hub) 프로세스에 정상 종료(SIGTERM) 신호를 전송하여 대화 잠금을 반환합니다: ${hub_pids[*]}"
    kill -TERM "${hub_pids[@]}" 2>/dev/null || true
    sleep 1
    log_info "잠금 반환 요청 완료. 'caw status' 명령으로 해제 여부를 확인하세요."
}

# 4. 종료된(EXITED) 멀티플렉서 세션 캐시 정리 (활성 세션은 보존)
cmd_clean() {
    local stop_claude=0
    if [[ "${1:-}" == "--stop-claude" ]]; then
        stop_claude=1
    fi

    local active_mux
    active_mux="$(resolve_active_mux)"

    if [[ "${active_mux}" == "zellij" ]] && command -v zellij >/dev/null 2>&1 && [[ ! -f "/.dockerenv" || "${SHARE_SOCKET}" == "true" ]]; then
        [[ "${SHARE_SOCKET}" == "true" ]] && export ZELLIJ_SOCKET_DIR="${ZELLIJ_SOCKET_DIR:-${MUX_ROOT}/zellij}"
        local exited_sessions=()
        while IFS= read -r line; do
            if [[ "${line}" == *"EXITED"* ]]; then
                local sname="${line%% *}"
                [[ -n "${sname}" ]] && exited_sessions+=("${sname}")
            fi
        done < <(zellij list-sessions -n 2>/dev/null || true)

        if [[ "${#exited_sessions[@]}" -gt 0 ]]; then
            local target
            for target in "${exited_sessions[@]}"; do
                log_info "종료된(EXITED) Zellij 세션 정리: ${target}"
                zellij delete-session "${target}" >/dev/null 2>&1 || true
            done
        else
            log_info "정리할 EXITED 상태의 Zellij 세션이 없습니다 (활성 세션은 보존됨)."
        fi
    elif [[ "${active_mux}" == "tmux" ]]; then
        log_info "tmux 모드에서는 종료된 세션이 자동 소멸되며 활성 세션만 보존됩니다."
    fi

    if [[ "${stop_claude}" -eq 1 ]] && command -v claude >/dev/null 2>&1; then
        log_info "Claude 백그라운드 세션 중지 요청(claude stop) 실행..."
        claude stop 2>/dev/null || log_warn "실행 중인 백그라운드 claude 데몬이 없거나 수동 종료가 필요합니다."
    fi
}

# 5. 환경 정합성 및 보안 권한 자가 진단
cmd_doctor() {
    local failures=0
    local active_mux
    active_mux="$(resolve_active_mux)"
    printf '=== CAW 환경 자가 진단 (버전: %s, 멀티플렉서: %s, 소켓직결: %s) ===\n' "${CAW_VERSION}" "${active_mux}" "${SHARE_SOCKET}"

    if [[ "${SHARE_SOCKET}" == "true" ]]; then
        if [[ -d "${MUX_ROOT}" ]]; then
            local perm
            perm="$(stat -c '%a' "${MUX_ROOT}" 2>/dev/null || echo 'unknown')"
            if [[ "${perm}" == "700" ]]; then
                printf '  [PASS] 공유 소켓 상위 디렉토리 권한 정상 (700): %s\n' "${MUX_ROOT}"
            else
                printf '  [FAIL] 공유 소켓 상위 디렉토리 권한 부적절 (%s != 700): %s\n' "${perm}" "${MUX_ROOT}"
                failures=$((failures + 1))
            fi
        else
            printf '  [WARN] 공유 소켓 디렉토리 아직 미생성: %s\n' "${MUX_ROOT}"
        fi
    else
        printf '  [PASS] 호스트 SSH 2중 인증 경계 활성화 (컨테이너 소켓 직결 차단됨)\n'
    fi

    local token_file="${HOST_HOME_DIR}/.gemini/antigravity/antigravity-oauth-token"
    if [[ -e "${token_file}" ]]; then
        printf '  [PASS] Antigravity 통합 인증 토큰 확인됨: %s\n' "${token_file}"
    else
        printf '  [WARN] 통합 인증 토큰 미확인 (로그인 전이거나 install.sh 실행 필요): %s\n' "${token_file}"
    fi

    local tool
    for tool in agy claude; do
        if command -v "${tool}" >/dev/null 2>&1; then
            printf '  [PASS] 에이전트 CLI 감지됨 (%s): %s\n' "${tool}" "$(command -v "${tool}")"
        else
            printf '  [WARN] 에이전트 CLI 미감지 (%s)\n' "${tool}"
        fi
    done

    if [[ ! -f "/.dockerenv" ]] && [[ "${active_mux}" == "zellij" || "${active_mux}" == "tmux" ]]; then
        if command -v "${active_mux}" >/dev/null 2>&1; then
            printf '  [PASS] 호스트 멀티플렉서 감지됨 (%s): %s\n' "${active_mux}" "$(command -v "${active_mux}")"
        else
            printf '  [FAIL] 호스트 멀티플렉서(%s) 실행 파일을 찾을 수 없음\n' "${active_mux}"
            failures=$((failures + 1))
        fi
    fi

    if [[ ! -f "/.dockerenv" ]] && [[ "${active_mux}" != "none" ]] && command -v loginctl >/dev/null 2>&1; then
        local linger_state
        linger_state="$(loginctl show-user "${USER:-$(id -un)}" -p Linger --value 2>/dev/null || echo 'unknown')"
        if [[ "${linger_state}" == "yes" ]]; then
            printf '  [PASS] systemd 사용자 세션 유지(Linger=yes) 활성화됨\n'
        else
            printf '  [FAIL] systemd Linger 비활성(%s) - SSH 로그아웃 시 멀티플렉서 종료 위험 (`sudo loginctl enable-linger %s` 필요)\n' "${linger_state}" "${USER:-$(id -un)}"
            failures=$((failures + 1))
        fi
    fi

    printf '  [PASS] PWA 앱 이름 설정: %s\n' "${CAW_PWA_APPNAME:-CAW}"
    local pwa_icon="${CAW_PWA_ICON:-}"
    if [[ -z "${pwa_icon}" ]]; then
        printf '  [PASS] PWA 아이콘: 기본 code-server 아이콘 사용 중\n'
    elif [[ "${pwa_icon}" == https://* ]]; then
        printf '  [PASS] PWA 아이콘(HTTPS URL): %s\n' "${pwa_icon}"
    elif [[ "${pwa_icon}" == /* ]]; then
        if [[ -e "${pwa_icon}" || -f "/.dockerenv" ]]; then
            printf '  [PASS] PWA 아이콘(컨테이너 경로): %s\n' "${pwa_icon}"
        else
            printf '  [PASS] PWA 아이콘(컨테이너 내부 경로 지정됨): %s\n' "${pwa_icon}"
        fi
    else
        local pwa_rel="${pwa_icon#./}"
        pwa_rel="${pwa_rel%/}"
        if [[ "${pwa_rel}" == "assets" || "${pwa_rel}" == "." ]]; then
            pwa_rel=""
        else
            pwa_rel="${pwa_rel#assets/}"
        fi
        [[ "${pwa_rel}" == "." ]] && pwa_rel=""
        local pwa_check_path="${STACK_ROOT}/assets${pwa_rel:+/${pwa_rel}}"
        if [[ -e "${pwa_check_path}" ]]; then
            printf '  [PASS] PWA 아이콘(assets): %s\n' "${pwa_check_path}"
        else
            printf '  [WARN] 지정된 PWA 아이콘을 찾을 수 없음: %s\n' "${pwa_check_path}"
        fi
    fi

    if [[ "${failures}" -gt 0 ]]; then
        log_err "자가 진단 결과 ${failures}건의 조치 필요 항목이 발견되었습니다."
        return 1
    fi
    log_info "자가 진단 통과 완료."
    return 0
}

cmd_help() {
    cat <<EOF
CAW (Continuous AI Workspace) CLI v${CAW_VERSION}

사용법:
  caw attach [세션명]        호스트 멀티플렉서(zellij/tmux) 세션 연결 단축 명령 (기본값: ${DEFAULT_SESSION})
  caw status                에이전트·멀티플렉서 자원 현황 및 대화 락(.lock) 조회
  caw unlock [--dry-run]    유휴 code-server 허브(agy --hub)의 대화 잠금 안전 반환
  caw clean [--stop-claude] 종료된(EXITED) 멀티플렉서 세션 캐시 정리
  caw doctor                보안 경계 모드, 통합 저장소 링크, systemd Linger 설정 점검
  caw version               패키지 버전 출력
  caw help                  도움말 출력
EOF
}

SUBCMD="${1:-help}"
shift || true

case "${SUBCMD}" in
    attach)               cmd_attach "$@" ;;
    status)               cmd_status "$@" ;;
    unlock)               cmd_unlock "$@" ;;
    clean)                cmd_clean "$@" ;;
    doctor)               cmd_doctor "$@" ;;
    version|--version|-v) printf '%s\n' "${CAW_VERSION}" ;;
    help|--help|-h)       cmd_help ;;
    *)
        log_err "알 수 없는 하위 명령입니다: ${SUBCMD}"
        cmd_help >&2
        exit 1
        ;;
esac
