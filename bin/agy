#!/usr/bin/env bash
# =============================================================================
# CAW 공용 래퍼 - Antigravity CLI (bin/agy)
# 목적:
#   1) IDE 확장(antigravity/)과 호스트 CLI가 동일한 SQLite 대화 저장소를 공유하도록
#      --app_data_dir=antigravity 옵션을 자동 주입하여 양방향 세션 연속성 보장
#   2) 외부 런타임(python3/node) 의존성 없이 순수 awk·bash로 현재 작업 디렉토리($PWD)와
#      일치하는 IDE 프로젝트 ID를 탐색하여 --project 자동 매칭
# =============================================================================
set -euo pipefail

SELF_REAL="$(realpath "${BASH_SOURCE[0]}")"
HOST_HOME_DIR="${CAW_HOST_HOME:-${HOME}}"

# 실제 agy 네이티브 바이너리 탐색 함수 (자기 자신 재귀 호출 원천 차단)
resolve_real_agy() {
    local candidate candidate_real
    local candidates=(
        "${HOST_HOME_DIR}/.gemini/bin/agy"
        "/config/.gemini/bin/agy"
        "${HOST_HOME_DIR}/.local/bin/agy.standalone"
        "/opt/caw/host-bin/agy"
    )

    for candidate in "${candidates[@]}"; do
        if [[ -x "${candidate}" ]]; then
            candidate_real="$(realpath "${candidate}" 2>/dev/null || true)"
            if [[ -n "${candidate_real}" && "${candidate_real}" != "${SELF_REAL}" ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
    done

    local IFS=':'
    local dir
    for dir in ${PATH}; do
        [[ -z "${dir}" ]] && continue
        candidate="${dir}/agy"
        if [[ -x "${candidate}" ]]; then
            candidate_real="$(realpath "${candidate}" 2>/dev/null || true)"
            if [[ -n "${candidate_real}" && "${candidate_real}" != "${SELF_REAL}" ]]; then
                printf '%s\n' "${candidate}"
                return 0
            fi
        fi
    done

    return 1
}

# 파이썬·노드 의존성 없이 현재 디렉토리($PWD) 기준 최장 일치 IDE 프로젝트 ID를 탐색하는 함수
resolve_project_id() {
    local projects_dir="${HOST_HOME_DIR}/.gemini/config/projects"
    if [[ ! -d "${projects_dir}" ]] && [[ -d "${HOME}/.gemini/config/projects" ]]; then
        projects_dir="${HOME}/.gemini/config/projects"
    fi

    if [[ ! -d "${projects_dir}" ]] || ! command -v awk >/dev/null 2>&1; then
        return 0
    fi

    local pwd_real
    pwd_real="$(realpath "$(pwd -P 2>/dev/null || pwd)" 2>/dev/null || pwd)"

    local best_id=""
    local best_len=-1
    local json_file proj_id raw_uri decoded folder prefix

    shopt -s nullglob
    for json_file in "${projects_dir}"/*.json; do
        proj_id="$(awk -F\" '
            {
                for (i = 1; i <= NF; i++) {
                    if ($i == "id" && $(i+1) ~ /^[[:space:]]*:[[:space:]]*$/) {
                        print $(i+2)
                        exit
                    }
                }
            }
        ' "${json_file}" 2>/dev/null || true)"

        if [[ -z "${proj_id}" ]]; then
            proj_id="$(basename "${json_file}" .json)"
        fi
        [[ -z "${proj_id}" ]] && continue

        while IFS= read -r raw_uri; do
            [[ -z "${raw_uri}" ]] && continue
            raw_uri="${raw_uri#file://}"
            # 리터럴 백슬래시 보호 후 퍼센트 인코딩(%XX, 한글 UTF-8 포함) 복원
            raw_uri="${raw_uri//\\/\\\\}"
            printf -v decoded '%b' "${raw_uri//%/\\x}"
            folder="$(realpath -m -- "${decoded}" 2>/dev/null || true)"
            [[ -z "${folder}" ]] && continue

            prefix="${folder%/}/"
            if [[ "${pwd_real}" == "${folder}" || "${pwd_real}" == "${prefix}"* ]]; then
                if (( ${#folder} > best_len )); then
                    best_len=${#folder}
                    best_id="${proj_id}"
                fi
            fi
        done < <(awk -F\" '
            {
                for (i = 1; i <= NF; i++) {
                    if (($i == "folderUri" || $i == "uri") && $(i+1) ~ /^[[:space:]]*:[[:space:]]*$/) {
                        if ($(i+2) ~ /^file:\/\//) print $(i+2)
                    }
                }
            }
        ' "${json_file}" 2>/dev/null || true)
    done
    shopt -u nullglob

    if [[ -n "${best_id}" ]]; then
        printf '%s' "${best_id}"
    fi
}

REAL_AGY="$(resolve_real_agy || true)"
if [[ -z "${REAL_AGY}" ]]; then
    echo "[CAW][ERROR] 실행 가능한 Antigravity(agy) 본체 바이너리를 찾을 수 없습니다." >&2
    echo "[CAW][INFO] code-server 내 Google Antigravity 확장을 활성화하거나 호스트에 agy CLI를 설치하세요." >&2
    exit 1
fi

HAS_APP_DATA_DIR=0
HAS_PROJECT=0
PASSTHROUGH_ONLY=0
IS_SUBCOMMAND=0
FIRST_POSITIONAL=""

# 값을 뒤따라 받는 옵션 인자까지 정확히 건너뛰며 첫 위치 인자(하위 명령)를 판별
ARGS=("$@")
TOTAL_ARGS="${#ARGS[@]}"
IDX=0
END_OF_OPTS=0

while (( IDX < TOTAL_ARGS )); do
    arg="${ARGS[IDX]}"
    if (( END_OF_OPTS == 1 )); then
        if [[ -z "${FIRST_POSITIONAL}" ]]; then
            FIRST_POSITIONAL="${arg}"
        fi
        IDX=$((IDX + 1))
        continue
    fi

    case "${arg}" in
        --)
            END_OF_OPTS=1
            ;;
        --app_data_dir|--app-data-dir)
            HAS_APP_DATA_DIR=1
            IDX=$((IDX + 1))
            ;;
        --app_data_dir=*|--app-data-dir=*)
            HAS_APP_DATA_DIR=1
            ;;
        --project)
            HAS_PROJECT=1
            IDX=$((IDX + 1))
            ;;
        --project=*)
            HAS_PROJECT=1
            ;;
        --hub|--help|-h|--version|-v)
            PASSTHROUGH_ONLY=1
            ;;
        -m|--model|-w|--workspace|--add-dir|--gemini_dir|--gemini-dir|--agent|--log-file|--cli_log_file|--output-format|-o|--approval-mode|-r|--resume|-c|--conversation|-p|--prompt)
            # 별도 값 인자를 소비하는 플래그는 다음 토큰을 건너뜀
            IDX=$((IDX + 1))
            ;;
        -*)
            ;;
        *)
            if [[ -z "${FIRST_POSITIONAL}" ]]; then
                FIRST_POSITIONAL="${arg}"
            fi
            ;;
    esac
    IDX=$((IDX + 1))
done

case "${FIRST_POSITIONAL}" in
    help|version|update|changelog|install|acp|remote-control|mic-serve)
        PASSTHROUGH_ONLY=1
        ;;
    models|plugin|plugins|mcp|agent|agents)
        IS_SUBCOMMAND=1
        ;;
esac

if [[ "${PASSTHROUGH_ONLY}" == "1" ]]; then
    exec "${REAL_AGY}" "$@"
fi

EXTRA_ARGS=()
if [[ "${HAS_APP_DATA_DIR}" == "0" ]]; then
    EXTRA_ARGS+=("--app_data_dir=antigravity")
fi

if [[ "${IS_SUBCOMMAND}" == "0" && "${HAS_PROJECT}" == "0" ]]; then
    MATCHED_PROJECT="$(resolve_project_id)"
    if [[ -n "${MATCHED_PROJECT}" ]]; then
        EXTRA_ARGS+=("--project" "${MATCHED_PROJECT}")
    fi
fi

exec "${REAL_AGY}" "${EXTRA_ARGS[@]}" "$@"
