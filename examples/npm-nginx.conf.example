# =============================================================================
# CAW 리버스 프록시 연동 레퍼런스 2 - Nginx / Nginx Proxy Manager (NPM) 설정 예시
# 목적:
#   Traefik 외에 NPM 또는 표준 Nginx를 사용하는 환경에서도 동일하게 웹소켓 터미널,
#   포트 포워딩(ide-<port>.example.com), Antigravity 웹뷰가 동작하도록 구성
#
# [Nginx Proxy Manager(NPM) GUI 설정 요약]
#   1) Proxy Host 추가 -> Details 탭 Domain Names: ide.example.com (단일 도메인만 입력)
#      * 주의: Nginx 규격상 'ide-*.example.com' 같은 접두사 와일드카드는 동작하지 않으며,
#              '*.example.com' 전체를 넣으면 타 프록시 호스트와 충돌할 수 있으므로 아래 5)의 정규식 사용 권장
#   2) Scheme: http / Forward Hostname: <CAW_BIND_ADDR> / Forward Port: 8443
#      * NPM이 Docker 브리지 컨테이너로 구동 중이면 127.0.0.1 대신 호스트의 내부 사설 IP 지정
#   3) Websockets Support: ON (필수 - 미체크 시 내장 터미널 및 에이전트 스트리밍 끊김)
#   4) SSL 탭: 와일드카드 인증서(*.example.com) 선택 + Force SSL 활성화 (인증서는 타 호스트와 공유 가능)
#   5) Advanced 탭 Custom Nginx Configuration 에 아래 1줄만 추가하여 포트 서브도메인(ide-<숫자>) 매칭:
#        server_name ~^ide-[0-9]+\.example\.com$;
#      * 주의: Advanced 탭에 'location /' 블록을 별도 선언하면 NPM 기본 프록시·WebSocket 블록이
#              대체되므로 위 server_name 정규식 1줄만 기입할 것 (NPM은 server 블록 직속으로 병합함)
# =============================================================================

# [표준 Nginx 단독 구성 시 설정 예시 (/etc/nginx/conf.d/caw-ide.conf)]
limit_req_zone $binary_remote_addr zone=caw_login_limit:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 메인 IDE 도메인에는 SAMEORIGIN 적용, 서브도메인 포트 프록시(ide-<port>)는
# 교차 서브도메인 웹뷰 iframe 허용을 위해 빈 문자열 지정 (Nginx는 빈 값 헤더를 자동 생략함)
map $host $caw_frame_options {
    default                      "SAMEORIGIN";
    ~^ide-[0-9]+\.example\.com$  "";
}

server {
    listen 443 ssl http2;
    # 메인 IDE 도메인 및 1단계 서브도메인 포트 프록시(ide-3000.example.com 등) 동시 수용
    server_name ide.example.com ~^ide-[0-9]+\.example\.com$;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # 보안 응답 헤더 (X-Frame-Options 는 위 map 분기에 따라 메인 도메인에만 부가됨)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options $caw_frame_options always;

    # 대용량 파일 업로드 및 긴 에이전트 스트리밍 타임아웃 보장
    client_max_body_size 50m;
    proxy_read_timeout   3600s;
    proxy_send_timeout   3600s;

    location / {
        limit_req zone=caw_login_limit burst=100 nodelay;

        # 동일 서버일 경우 127.0.0.1:8443, 원격 프록시일 경우 CAW 서버 내부망 IP 지정
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;

        # 원본 Host 헤더 보존 필수 (code-server 서브도메인 포트 라우팅 및 AGY_ALLOWED_DOMAINS 검증용)
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 업그레이드 필수
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_buffering off;
    }
}
