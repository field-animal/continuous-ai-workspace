# =============================================================================
# CAW 리버스 프록시 연동 레퍼런스 2 - Nginx / Nginx Proxy Manager (NPM) 설정 예시
# 목적:
#   Traefik 외에 NPM 또는 표준 Nginx를 사용하는 환경에서도 동일하게 웹소켓 터미널,
#   포트 포워딩(ide-<port>.example.com), Antigravity 웹뷰가 동작하도록 구성
#
# [Nginx Proxy Manager(NPM) GUI 설정 요약]
#   1) Proxy Host 추가 -> Domain Names: ide.example.com, *.example.com (또는 정규식 지원 시 분리)
#   2) Scheme: http / Forward Hostname: <CAW_BIND_ADDR> / Forward Port: 8443
#   3) Websockets Support: ON (필수 - 미체크 시 터미널 및 에이전트 스트리밍 끊김)
#   4) SSL 탭: 와일드카드 인증서(*.example.com) 선택 + Force SSL + HTTP/2 Support 활성화
#   5) Advanced 탭 Custom Nginx Configuration 에 아래 location 내부 헤더 설정 추가
# =============================================================================

# [표준 Nginx 단독 구성 시 설정 예시 (/etc/nginx/conf.d/caw-ide.conf)]
limit_req_zone $binary_remote_addr zone=caw_login_limit:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    # 메인 IDE 도메인 및 1단계 서브도메인 포트 프록시(ide-3000.example.com 등) 동시 수용
    server_name ide.example.com ~^ide-[0-9]+\.example\.com$;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # 보안 응답 헤더
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 대용량 파일 업로드 및 긴 에이전트 스트리밍 타임아웃 보장
    client_max_body_size 50m;
    proxy_read_timeout   3600s;
    proxy_send_timeout   3600s;

    location / {
        limit_req zone=caw_login_limit burst=100 nodelay;

        # 동일 서버일 경우 127.0.0.1:8443, 원격 프록시일 경우 CAW 서버 내부망 IP 지정
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;

        # 원본 Host 헤더 보존 필수 (code-server 서브도메인 포트 라우팅 및 AGY_ALLOWED_DOMAINS 검증용)
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 업그레이드 필수
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_buffering off;
    }
}
