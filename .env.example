# =============================================================================
# CAW (Continuous AI Workspace) 환경변수 템플릿 (.env.example)
# 사용법: cp .env.example .env && chmod 600 .env 실행 후 필요한 항목만 수정
# 주의: 실제 비밀번호가 기입된 .env 파일은 절대 Git 저장소에 커밋하지 말 것
# =============================================================================

# ----- 1. 컨테이너 이미지 버전 고정 (업스트림 예기치 않은 변경 방지) -----
CAW_IMAGE_REPO=lscr.io/linuxserver/code-server
CAW_IMAGE_TAG=4.145.2
CAW_CONTAINER_NAME=code-server

# ----- 2. 호스트 사용자 및 핵심 경로 매핑 (비워두면 현재 실행 계정 기준으로 자동 치환) -----
# 미선언(빈 값) 시 자동 적용 기본값:
#   PUID             -> 현재 사용자의 UID (id -u, Compose 단독 실행 시 ${UID:-1000})
#   PGID             -> 현재 사용자의 GID (id -g, Compose 단독 실행 시 ${GID:-1000})
#   HOST_USER        -> 현재 로그인 계정명 ($USER)
#   HOST_HOME        -> 현재 사용자의 홈 디렉토리 ($HOME)
#   CAW_CONFIG_DIR   -> ${HOST_HOME}/.local/share/caw/code-server-config (기존 운영 서버 전환 시 기존 경로 지정)
#   CAW_WORKSPACE_DIR-> ${HOST_HOME}/workspace
# * 복수의 추가 워크스페이스 디렉토리 마운트가 필요한 경우 compose.override.yml.example 참조
PUID=
PGID=
HOST_USER=
HOST_HOME=
CAW_CONFIG_DIR=
CAW_WORKSPACE_DIR=

# ----- 3. 네트워크 바인딩 및 리버스 프록시 연동 (프록시 중립) -----
# 보안 기본값: 로컬호스트(127.0.0.1)만 바인딩하여 외부 무인증 직접 노출 차단
# 별도 호스트/컨테이너의 리버스 프록시(Traefik, NPM, Nginx)에서 접근해야 할 경우에만
# 해당 서버의 내부망 사설 인터페이스 IP로 변경할 것
CAW_BIND_ADDR=127.0.0.1
CAW_PORT=8443

# 외부 접속용 베이스 도메인 (서브도메인 포트 프록시 ide-<port>.<도메인> 및 Antigravity CSP 허용용)
CAW_BASE_DOMAIN=example.com
CAW_PROXY_DOMAIN_TEMPLATE=ide-{{port}}.example.com
CAW_COOKIE_SUFFIX=_caw

# ----- 4. 인증 정보 (필수 설정 - 평문 대신 Argon2 해시 권장, 최소 12자 이상 권장) -----
# CAW_HASHED_PASSWORD 설정 시 CAW_PASSWORD 보다 우선 적용됨 (둘 다 비어 있으면 설치 거부)
# 주의: Argon2 해시는 내부에 $ 기호를 포함하므로 Docker Compose 변수 치환 방지를 위해 반드시 작은따옴표('...')로 감쌀 것
# 예시: CAW_HASHED_PASSWORD='$argon2id$v=19$m=4096,t=3,p=1$...'
CAW_HASHED_PASSWORD=
CAW_PASSWORD=
CAW_SUDO_PASSWORD=

# ----- 5. 터미널 멀티플렉서 및 보안 경계 토글 -----
# 호스트에서 사용할 멀티플렉서 종류: auto | zellij | tmux | none
#   - auto  : 호스트에 이미 설치된 도구(zellij 또는 tmux) 1종만 자동 감지하여 준비
#             (설치된 도구가 없을 경우 대화형 터미널에서 tmux / zellij / 설치 안 함 선택 제공)
#   - zellij: 호스트 zellij 단독 준비 (미설치 시 ~/.local/bin 에 공식 정적 바이너리 설치)
#   - tmux  : 호스트 tmux 단독 준비 (미설치 시 OS 패키지 매니저로 설치)
#   - none  : 멀티플렉서 준비 생략
CAW_MULTIPLEXER=auto
CAW_SESSION_NAME=caw
# zellij 미설치 호스트에서 자동 설치 선택 시 사용할 고정 릴리스 버전
CAW_ZELLIJ_VERSION=v0.45.1

# [보안 기본값: false - 호스트 SSH 2중 인증 경계 유지]
#   - false(권장): 컨테이너에 호스트 멀티플렉서 소켓을 마운트하지 않으며, 내장 터미널에서 호스트로
#                  ssh 로그인(2차 인증)한 뒤 순정 멀티플렉서 세션을 사용함
#   - true(선택) : SSH 인증 없이 내장 터미널에서 호스트 멀티플렉서 소켓에 직결함
#                  (사용 시 docker-compose.yml 의 3번 소켓 마운트 블록 주석도 함께 해제해야 하며,
#                   컨테이너 침해 시 호스트 셸에 즉시 접근 가능해지므로 폐쇄망에서만 제한적으로 사용)
CAW_SHARE_MUX_SOCKET=false
CAW_MUX_SOCKET_DIR=

# 컨테이너 기동 시 공식 갤러리(Open VSX) 확장 자동 설치 여부 (true | false)
CAW_AUTO_INSTALL_EXTENSIONS=true

# 호스트 Docker 소켓 연동(DooD) 활성화 여부 (true 설정 시 compose.dood.yml 자동 결합)
# 주의: 컨테이너 내부에서 호스트 Docker 제어가 가능하므로 신뢰된 환경에서만 활성화할 것
CAW_ENABLE_DOOD=false
CAW_DOCKER_SOCK=/var/run/docker.sock

# ----- 6. PWA 앱 이름 및 아이콘 브랜딩 (선택) -----
# 브라우저 "앱 설치(PWA)" 시 표시되는 앱 이름 (비워 두면 기본값 CAW 사용)
# 공백이 포함된 경우 큰따옴표로 감쌀 것 (예: CAW_PWA_APPNAME="My AI IDE")
CAW_PWA_APPNAME=CAW

# 브라우저 파비콘 및 PWA 앱 아이콘 경로 또는 HTTPS URL (비워 두면 기본 code-server 아이콘 유지)
# 지원 형식:
#   1) ./assets/ 내 파일명/상대경로 (예: ./assets/caw-icon.png 또는 caw-icon.png - 권장: 512x512 정사각형 PNG, PWA 4종 및 파비콘 일괄 자동 적용)
#   2) 컨테이너 내부 절대경로 (예: /config/my-icon.png, /opt/caw/assets/caw-icon.png)
#   3) 표준 아이콘 파일(pwa-icon-192.png, pwa-icon-512.png, pwa-icon-maskable-192.png, pwa-icon-maskable-512.png,
#      favicon-dark-support.svg, favicon.ico)을 담은 디렉토리 경로 (예: ./assets/pwa 또는 ./assets)
#   4) HTTPS URL (예: https://example.com/icon.png - 보안상 https:// 만 허용, 최대 5MB)
CAW_PWA_ICON=./assets/caw-icon.png
